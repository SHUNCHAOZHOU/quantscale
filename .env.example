DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Flash is fixed to deepseek-flash. Role-specific defaults:
DEEPSEEK_RESEARCHER_REASONING_EFFORT=low
DEEPSEEK_RESEARCHER_MAX_OUTPUT_TOKENS=32768
DEEPSEEK_MANAGER_REASONING_EFFORT=none
DEEPSEEK_MANAGER_MAX_OUTPUT_TOKENS=8192
# Legacy DEEPSEEK_REASONING_EFFORT / DEEPSEEK_MAX_OUTPUT_TOKENS still apply
# to both roles when no corresponding role-specific override is supplied.
